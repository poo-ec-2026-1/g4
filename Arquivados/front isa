CLASSE TELA PEDIDOS

import javafx.application.Application;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.TableColumn;
import javafx.scene.control.TableView;
import javafx.scene.layout.VBox;
import javafx.stage.Stage;

public class TelaPedido extends Application {

    private Pedido pedido = new Pedido();

    @Override
    public void start(Stage stage) {

        Button btnVoltar = new Button("Voltar");
        Button btnTotal = new Button("Calcular Total");

        Label lblTotal = new Label("Total: R$ 0.00");

        TableView<Produto> tabela = new TableView<>();

        TableColumn<Produto, String> colTipo = new TableColumn<>("Tipo");

        TableColumn<Produto, Double> colArea = new TableColumn<>("Área");

        TableColumn<Produto, Double> colPreco = new TableColumn<>("Preço");

        tabela.getColumns().addAll(
                colTipo,
                colArea,
                colPreco
        );

        btnTotal.setOnAction(e -> {

            double total = pedido.calcularTotal();

            lblTotal.setText("Total: R$ " + String.format("%.2f", total));

        });

        btnVoltar.setOnAction(e -> {

            System.out.println("Voltar para Tela Principal");

        });

        VBox layout = new VBox(
                10,
                tabela,
                btnTotal,
                lblTotal,
                btnVoltar
        );

        Scene scene = new Scene(layout, 600, 400);

        stage.setTitle("Pedidos");
        stage.setScene(scene);
        stage.show();
    }

    public static void main(String[] args) {
        launch(args);
    }
}
