        valor.setCellValueFactory(c -> new SimpleStringProperty(moeda(c.getValue().calcularTotal())));
        valor.setPrefWidth(130);
        TableColumn<Orcamento, String> comissao = new TableColumn<Orcamento, String>("Comissao");
