<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.FormularioToldoController"
      spacing="15"
      style="-fx-background-color:white;
             -fx-background-radius:10;
             -fx-border-color:#d0d0d0;
             -fx-border-radius:10;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Toldo"
           style="-fx-font-size:20px;
                  -fx-font-weight:bold;"/>

    <GridPane hgap="15" vgap="15">

        <Label text="Modelo:"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"/>

        <ComboBox fx:id="cbModelo"
                  promptText="Selecione"
                  GridPane.rowIndex="0"
                  GridPane.columnIndex="1"/>
                  
        <Label fx:id="cdMaterial"
               text="Material:"
               GridPane.rowIndex="1"
               GridPane.columnIndex="0"/>

        <ComboBox promptText="Selecione"
                  GridPane.rowIndex="1"
                  GridPane.columnIndex="1"/>
        

        <Label text="Largura (m):"
               GridPane.rowIndex="2"
               GridPane.columnIndex="0"/>

        <TextField promptText="Ex.: 3,50"
                   GridPane.rowIndex="2"
                   GridPane.columnIndex="1"/>

        <Label text="Altura (m):"
               GridPane.rowIndex="3"
               GridPane.columnIndex="0"/>

        <TextField promptText="Ex.: 2,80"
                   GridPane.rowIndex="3"
                   GridPane.columnIndex="1"/>

        <Label text="Cor:"
               GridPane.rowIndex="4"
               GridPane.columnIndex="0"/>

        <TextField promptText="Cor"
                   GridPane.rowIndex="4"
                   GridPane.columnIndex="1"/>

        <Label text="Observações:"
               GridPane.rowIndex="5"
               GridPane.columnIndex="0"/>

        <TextField promptText="Opcional"
                   GridPane.rowIndex="5"
                   GridPane.columnIndex="1"/>

    </GridPane>

</VBox>
