//INTERFACE
public interface Validavel {

    boolean validar();
}

//CLIENTES
public class Cliente implements Validavel {

    private Integer id;
    private String nome;
    private String documento;

    public Cliente(String nome,
                   String documento) {

        this.nome = nome;

        this.documento = documento.replaceAll("[^0-9]", "");
        
        if(!validar()){
            throw new IllegalArgumentException("Documento invalido, deve conter 11 (cpf) ou 14 (cnpj) digitos");
        }
    }

    @Override
    public boolean validar() {

        return documento.length() == 11
                || documento.length() == 14;
    }

    public Integer getId() {
        return id;
    }

    public void setId(Integer id) {
        this.id = id;
    }

    public String getNome() {
        return nome;
    }

    public String getDocumento() {
        return documento;
    }
}

// PRODUTOS
public abstract class Produto {

    protected double largura;
    protected double altura;
    protected double precoM2;

    public Produto(double largura,
                   double altura) {

        this.largura = largura;
        this.altura = altura;
    }

    public double getArea() {

        return largura * altura;
    }

    public double calcularPreco() {

        return getArea() * this.precoM2;
    }

    public double getLargura() {
        return this.largura;
    }

    public double getAltura() {
        return this.altura;
    }

    public double getPrecoM2() {
        return this.precoM2;
    }
}

//TOLDO
public class Toldo extends Produto {

    private String material;
    private String tipo;
    private String cor;

    public Toldo(double largura,
                 double altura,
                 String material,
                 String tipo,
                 String cor) {

        super(largura, altura);

        this.material = material;
        this.tipo = tipo;
        this.cor = cor;

        switch(material.toLowerCase()) {

            case "madeira":
                precoM2 += 250;
                break;

            case "aluminio":
                precoM2 += 180;
                break;

            case "aco":
                precoM2 += 220;
                break;

            default:
                precoM2 += 150;
        }

        switch(tipo.toLowerCase()) {

            case "retratil":
                precoM2 += 120;
                break;

            case "reto":
                precoM2 += 50;
                break;

            case "curvo":
                precoM2 += 90;
                break;
        }
    }
}

//CORTINA
public class Cortina extends Produto {

    protected String tecido;

    public Cortina(double largura,
                   double altura,
                   String tecido) {

        super(largura, altura);

        this.tecido = tecido;

        switch(tecido.toLowerCase()) {

            case "voil":
                precoM2 = 40;
                break;

            case "linho":
                precoM2 = 70;
                break;

            case "blackout":
                precoM2 = 90;
                break;

            default:
                precoM2 = 50;
        }
    }
    public String getTecido(){
        return this.tecido;
    }
}

//ORÇAMENTO
import java.util.ArrayList;
import java.util.List;

public class Orcamento {

    private Integer id;
    private Cliente cliente;

    private List<Produto> produtos =
            new ArrayList<>();

    public Orcamento(Cliente cliente) {

        this.cliente = cliente;
    }

    public void addProduto(
            Produto produto) {

        this.produtos.add(produto);
    }

    public double calcularTotal() {

        double total = 0;

        for(Produto p : produtos) {

            total += p.calcularPreco();
        }

        return total;
    }
    public Cliente getCliente(){
        return this.cliente;
    }
    public int getTotalProdutos(){
        return this.produtos.size();
    }
}

//Verificador
import java.util.ArrayList;
import java.util.List;

public class VerificadorCadastro {
    private List<Cliente> clientesCadastrados = new ArrayList<>();
    
    public boolean adicionarCliente(Cliente novoCliente) {
        for (Cliente a : clientesCadastrados) {
            if (a.getDocumento().equals(novoCliente.getDocumento())) {
                System.out.println("Cadastro negado: documento ja cadastrado");
                return false;
            }
        }
        clientesCadastrados.add(novoCliente);
        System.out.println("Cliente - " + novoCliente.getNome() + " - cadastrado com sucesso");
        return true;
    }
}

