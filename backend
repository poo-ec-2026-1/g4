//ESSA É A CLASSE ABSTRATA DOS PRODUTOS

public abstract class Produto {
    protected double largura, altura, precoM2=0;

    public Produto(double largura, double altura) {
        this.largura = largura;
        this.altura = altura;
    }

    public double getArea() {
        return largura * altura;
    }

    public double calcularPreco(){
        return this.getArea()*this.precoM2;
    }
    public double getLargura(){
        return this.largura;
    }
    public double getAltura(){
        return this.altura;
    }
    public double getPrecoM2(){
        return this.precoM2;
    }
}

//CLASSE PARA OS TOLDOS(NÃO INCLUI CORTINAS)

public class Toldo extends Produto {

    protected String material;
    protected String tipo;
    protected String cor;

    public Toldo(double largura, double altura, String material, String tipo, String cor){

        super(largura, altura);
        this.material = material;
        this.tipo = tipo;
        this.cor = cor;

        // Material
        switch (material.toLowerCase()){
            case "madeira":
                precoM2 += 250;
                break;
            case "aluminio":
                precoM2 += 180;
                break;
            case "aco":
                precoM2 += 220;
                break;
            default:
                precoM2 += 150;
        }

        // Tipo
        switch (tipo.toLowerCase()) {
            case "retratil":
                precoM2 += 120;
                break;
            case "reto":
                precoM2 += 50;
                break;
            case "curvo":
                precoM2 += 90;
                break;
        }
    }
    public String getCor() {
        return this.cor;
    }
    public String getMaterial(){
        return this.material;
    }
    public String getTipo(){
        return this.tipo;
    }
}

//ESSA É A DAS CORTINAS

public class Cortina extends Produto {
    protected String tecido;
    public Cortina(double largura, double altura, String tecido) {
        super(largura, altura);
        this.tecido = tecido;
        
        switch (tecido.toLowerCase()) {
            case "voil":
                precoM2 = 40;
                break;
            case "linho":
                precoM2 = 70;
                break;
            case "blackout":
                precoM2 = 90;
                break;
            default:
                precoM2 = 50;
        }
    }
    public String getTecido(){
        return this.tecido;
    }
}

//ESSA É DO PEDIDO(COMO VAI FUNCIONAR?)

import java.util.ArrayList;
import java.util.List;

public class Pedido {
    protected double total=0;

    private List<Produto> itens = new ArrayList<>();

    public void adicionarItem(Produto produto) {
        itens.add(produto);
    }

    public double calcularTotal() {

        for (Produto produto : itens) {
            total += produto.calcularPreco();
        }

        return total;
    }
}


//Classe de teste funcional, exemplificando o funcionamento atual

public class Programa{
    public static void main(String[]args){
        Pedido pedido1= new Pedido();

        Toldo toldo1= new Toldo(3,1.7,"aco","retratil","preto");

        Cortina cortina1= new Cortina(1.8, 1.2, "blackout");

        pedido1.adicionarItem(toldo1);
        pedido1.adicionarItem(cortina1);

        System.out.println("Configuracoes do toldo:\nLargura: "+toldo1.getLargura()+"  Altura: "+toldo1.getAltura()+
        "  Preco por m²: "+String.format("%.2f",toldo1.getPrecoM2())+" R$\n");

        System.out.println("Configuracoes da cortina:\nLargura: "+cortina1.getLargura()+"  Altura: "+cortina1.getAltura()+
        "  Preco por m²: "+String.format("%.2f",cortina1.getPrecoM2())+" R$\n");

        System.out.println("Preco do toldo: "+String.format("%.2f",toldo1.calcularPreco())+
        "R$\nPreco da cortina: "+String.format("%.2f",cortina1.calcularPreco())+"R$\n\nTotal do pedido: "
        +String.format("%.2f",pedido1.calcularTotal())+"R$\n");
    }
}
