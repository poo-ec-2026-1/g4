//ESSA É A CLASSE ABSTRATA DOS PRODUTOS

public abstract class Produto {
    protected double largura, altura, precoM2=0;

    public Produto(double largura, double altura) {
        this.largura = largura;
        this.altura = altura;
    }

    public double getArea() {
        return largura * altura;
    }

    public double calcularPreco(){
        return this.getArea()*this.precoM2;
    }
    public double getLargura(){
        return this.largura;
    }
    public double getAltura(){
        return this.altura;
    }
    public double getPrecoM2(){
        return this.precoM2;
    }
}

//CLASSE PARA OS TOLDOS(NÃO INCLUI CORTINAS)

public class Toldo extends Produto {

    protected String material;
    protected String tipo;
    protected String cor;

    public Toldo(double largura, double altura, String material, String tipo, String cor){

        super(largura, altura);
        this.material = material;
        this.tipo = tipo;
        this.cor = cor;

        // Material
        switch (material.toLowerCase()){
            case "madeira":
                precoM2 += 250;
                break;
            case "aluminio":
                precoM2 += 180;
                break;
            case "aco":
                precoM2 += 220;
                break;
            default:
                precoM2 += 150;
        }

        // Tipo
        switch (tipo.toLowerCase()) {
            case "retratil":
                precoM2 += 120;
                break;
            case "reto":
                precoM2 += 50;
                break;
            case "curvo":
                precoM2 += 90;
                break;
        }
    }
    public String getCor() {
        return this.cor;
    }
    public String getMaterial(){
        return this.material;
    }
    public String getTipo(){
        return this.tipo;
    }
}

//ESSA É A DAS CORTINAS

public class Cortina extends Produto {
    protected String tecido;
    public Cortina(double largura, double altura, String tecido) {
        super(largura, altura);
        this.tecido = tecido;
        
        switch (tecido.toLowerCase()) {
            case "voil":
                precoM2 = 40;
                break;
            case "linho":
                precoM2 = 70;
                break;
            case "blackout":
                precoM2 = 90;
                break;
            default:
                precoM2 = 50;
        }
    }
    public String getTecido(){
        return this.tecido;
    }
}

//ESSA É DO PEDIDO(COMO VAI FUNCIONAR?)

import java.util.ArrayList;
import java.util.List;

public class Pedido {
    private Cliente cliente;
    private List<Produto> itens = new ArrayList<>();
    
    Pedido(Cliente cliente){
        this.cliente=cliente;
    }

    public void adicionarItem(Produto produto) {
        itens.add(produto);
    }

    public double calcularTotal() {
        double total=0;

        for (Produto produto : itens) {
            total += produto.calcularPreco();
        }

        return total;
    }
    public Cliente getCliente(){
        return this.cliente;
    }
}



//Classe de Cliente

public class Cliente{
    protected String nome, documento;
    Cliente(String nome, String documento){
        String limpo=documento.replaceAll("[^0-9]","");
        if(limpo.length() !=11 && limpo.length() !=14){
            throw new IllegalArgumentException("Dimensoes do documento nao aceitas");
        }
        this.nome=nome;
        this.documento=limpo;
    }
    public String getNome(){
        return this.nome;
    }
    public String getDocumento(){
        return this.documento;
    }
}

//Verificador para disponibilidade do documento

import java.util.ArrayList;
import java.util.List;

public class Verificador{
    private List<Cliente>clientCadas=new ArrayList<>();
    boolean adicionarCliente(Cliente novoCliente){
        for(Cliente a: clientCadas){
            if(a.getDocumento().equals(novoCliente.getDocumento())){
                System.out.println("Cadastro negado, documento ja cadastrado!");
                return false;
            }
        }
        clientCadas.add(novoCliente);
        System.out.println("Cliente cadastrado com sucesso!");
        return true;
    }
}

